    { "id": "t03", "category": "taxi", "english": "Turn right", "arabic": "لف يمين", "transliteration": "liff yameen" },
    { "id": "t04", "category": "taxi", "english": "Turn left", "arabic": "لف يسار", "transliteration": "liff yasaar" },
    { "id": "t05", "category": "taxi", "english": "Stop here", "arabic": "وقف هنا", "transliteration": "waggif hina" },
