    { "id": "g01", "category": "greetings", "english": "Hello (peace be upon you)", "arabic": "السلام عليكم", "transliteration": "as-salaam 'alaykum" },
    { "id": "g02", "category": "greetings", "english": "And peace upon you (the reply)", "arabic": "وعليكم السلام", "transliteration": "wa 'alaykum as-salaam" },
    { "id": "g03", "category": "greetings", "english": "Good morning", "arabic": "صباح الخير", "transliteration": "sabaah al-khair" },
    { "id": "g04", "category": "greetings", "english": "Good morning (the reply)", "arabic": "صباح النور", "transliteration": "sabaah an-noor" },
    { "id": "g05", "category": "greetings", "english": "How are you?", "arabic": "كيف حالك؟", "transliteration": "keef haalak?" },
    { "id": "g06", "category": "greetings", "english": "Good, praise God", "arabic": "بخير الحمد لله", "transliteration": "bi-khair al-hamdu lillah" },
    { "id": "g07", "category": "greetings", "english": "Welcome", "arabic": "حياك الله", "transliteration": "hayyaak allah" },
    { "id": "g08", "category": "greetings", "english": "Please / excuse me", "arabic": "لو سمحت", "transliteration": "law samaht" },
    { "id": "g09", "category": "greetings", "english": "Thank you (may God give you wellness)", "arabic": "الله يعطيك العافية", "transliteration": "allah ya'teek al-'afya" },
    { "id": "g10", "category": "greetings", "english": "With pleasure / you're welcome", "arabic": "على خشمي", "transliteration": "'ala khashmi" },
    { "id": "g11", "category": "greetings", "english": "Consider it done", "arabic": "أبشر", "transliteration": "abshir" },
    { "id": "g12", "category": "greetings", "english": "Sorry", "arabic": "آسف", "transliteration": "aasif" },
    { "id": "g13", "category": "greetings", "english": "No problem", "arabic": "ما فيه مشكلة", "transliteration": "ma feeh mushkila" },
    { "id": "g14", "category": "greetings", "english": "Goodbye", "arabic": "مع السلامة", "transliteration": "ma' as-salaama" },
    { "id": "g15", "category": "greetings", "english": "God willing", "arabic": "إن شاء الله", "transliteration": "in shaa allah" },

    { "id": "t01", "category": "taxi", "english": "Take me to...", "arabic": "وديني إلى", "transliteration": "waddeeni ila" },
