    { "id": "o01", "category": "office", "english": "Good morning, everyone", "arabic": "صباح الخير على الجميع", "transliteration": "sabaah al-khair 'ala al-jamee'" },
    { "id": "o02", "category": "office", "english": "How was your weekend?", "arabic": "كيف كانت الإجازة؟", "transliteration": "keef kaanat al-ijaaza?" },
    { "id": "o03", "category": "office", "english": "I have a meeting", "arabic": "عندي اجتماع", "transliteration": "'indi ijtimaa'" },
