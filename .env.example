# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the key. .env.local is gitignored.
#
#   cp .env.example .env.local
#
# Restart `npm run dev` after editing — Next.js only reads env at boot.
# ---------------------------------------------------------------------------

# REQUIRED. Google Gemini API key. Powers both translation directions.
# Get one free at https://aistudio.google.com/apikey
# (Google AI Studio -> "Get API key" -> "Create API key". No billing needed
#  for the free tier, which is far more than personal use requires.)
GOOGLE_GENERATIVE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Optional. Everything below has a working default.
# ---------------------------------------------------------------------------

# Model used for Speak mode (English text -> Arabic JSON).
# Default "gemini-flash-latest" tracks the current Flash release.
# Pin it (e.g. "gemini-2.5-flash") if you want reproducible output, or if your
# key returns a 404 for the floating alias.
# GEMINI_TEXT_MODEL=gemini-flash-latest

# Model used for Listen mode (Arabic audio -> English). Must accept audio input.
# GEMINI_AUDIO_MODEL=gemini-flash-latest

# Abort a model call after this many milliseconds. Default 20000.
# AI_TIMEOUT_MS=20000
