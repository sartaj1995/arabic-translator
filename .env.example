# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the key. .env.local is gitignored.
#
#   cp .env.example .env.local
#
# Restart `npm run dev` after editing — Next.js only reads env at boot.
# ---------------------------------------------------------------------------

# REQUIRED. Google Gemini API key. Powers both translation directions.
# Get one free at https://aistudio.google.com/apikey
# (Google AI Studio -> "Get API key" -> "Create API key". No billing needed
#  for the free tier, which is far more than personal use requires.)
#
# Keys come in two formats and BOTH work here:
#   AIza...  older format, still issued by Google Cloud Console
#   AQ.Ab... current Google AI Studio format (since mid-2026)
# AQ. keys authenticate only via the x-goog-api-key header, which the official
# SDK this app uses sets for you. Nothing to configure.
GOOGLE_GENERATIVE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Optional. Everything below has a working default.
# ---------------------------------------------------------------------------

# Model used for Speak mode (English text -> Arabic JSON).
# Defaults to gemini-3.8-flash, pinned on purpose: floating aliases such as
# "gemini-flash-latest" do not resolve on every API key, and the 2.5 models
# now only serve keys that had already used them.
# GEMINI_TEXT_MODEL=gemini-3.8-flash

# Model used for Listen mode (Arabic audio -> English). Must accept audio input.
# gemini-3.8-flash is multimodal, so the same default serves both.
# GEMINI_AUDIO_MODEL=gemini-3.8-flash

# Second model tried when the primary fails in a way another model could avoid
# (overloaded, retired). Serves both routes, so it must accept audio input.
# Set it to the same name as the primary to switch the fallback off.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Abort a model call after this many milliseconds. Default 20000.
# AI_TIMEOUT_MS=20000
